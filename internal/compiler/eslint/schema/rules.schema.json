{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipsoplatform.io/schema/eslint-rules.json",
  "title": "ESLint rules compiled by ipso",
  "type": "object",
  "additionalProperties": false,
  "required": ["files", "rules"],
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "ignores": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "enum": ["error", "warn", "off"] },
          {
            "type": "array",
            "minItems": 1,
            "prefixItems": [{ "enum": ["error", "warn", "off"] }],
            "items": true
          }
        ]
      }
    }
  }
}
