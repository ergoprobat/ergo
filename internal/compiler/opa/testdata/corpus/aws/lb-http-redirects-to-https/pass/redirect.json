{
  "resource_changes": [
    {
      "address": "aws_lb_listener.http",
      "mode": "managed",
      "type": "aws_lb_listener",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "protocol": "HTTP",
          "port": 80,
          "default_action": [
            {
              "type": "redirect",
              "redirect": [
                {
                  "protocol": "HTTPS",
                  "port": "443",
                  "status_code": "HTTP_301"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "address": "aws_lb_listener.https",
      "mode": "managed",
      "type": "aws_lb_listener",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "protocol": "HTTPS",
          "port": 443,
          "default_action": [
            {
              "type": "forward"
            }
          ]
        }
      }
    }
  ]
}
