{
  "resource_changes": [
    {
      "address": "aws_s3_bucket.logs",
      "mode": "managed",
      "type": "aws_s3_bucket",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "bucket": null,
          "id": null
        },
        "after_unknown": {
          "bucket": true,
          "id": true
        }
      }
    },
    {
      "address": "aws_s3_bucket_server_side_encryption_configuration.logs",
      "mode": "managed",
      "type": "aws_s3_bucket_server_side_encryption_configuration",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "bucket": null,
          "rule": [
            {
              "apply_server_side_encryption_by_default": [
                {
                  "sse_algorithm": "aws:kms",
                  "kms_master_key_id": "arn:aws:kms:eu-central-1:123456789012:key/abcd"
                }
              ]
            }
          ]
        },
        "after_unknown": {
          "bucket": true
        }
      }
    }
  ],
  "configuration": {
    "root_module": {
      "resources": [
        {
          "address": "aws_s3_bucket.logs",
          "mode": "managed",
          "type": "aws_s3_bucket",
          "expressions": {
            "bucket": {
              "constant_value": "logs"
            }
          }
        },
        {
          "address": "aws_s3_bucket_server_side_encryption_configuration.logs",
          "mode": "managed",
          "type": "aws_s3_bucket_server_side_encryption_configuration",
          "expressions": {
            "bucket": {
              "references": [
                "aws_s3_bucket.logs.id",
                "aws_s3_bucket.logs"
              ]
            }
          }
        }
      ]
    }
  }
}
