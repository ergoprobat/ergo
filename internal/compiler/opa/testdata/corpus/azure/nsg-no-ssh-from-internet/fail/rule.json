{
  "resource_changes": [
    {
      "address": "azurerm_network_security_rule.ssh",
      "mode": "managed",
      "type": "azurerm_network_security_rule",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "name": "ssh",
          "direction": "Inbound",
          "access": "Allow",
          "protocol": "Tcp",
          "destination_port_range": "22",
          "source_address_prefix": "*",
          "destination_address_prefix": "*"
        }
      }
    }
  ]
}
